MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2073858365}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 199f375115502e748a54b5997d9f2add, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GetYourPhD.HowToPlayOverlay
  levelId: L4
  title: 'LEVEL 4: CLIMB THE PAULINUM'
  intro: "The defense starts at <b>14:00</b> in the <b>Felix-Klein-H\xF6rsaal</b>
    on the top floor, and the lift is <b>\"AUSSER BETRIEB\"</b>. Johannes <b>bounces
    by himself</b>: just steer him from platform to platform through the Foyer, Lecture
    Halls, Library and Felix-Klein-H\xF6rsaal. Falling off the screen drops him back
    to the last landing (-10 s). At the top you face Prof. Siegmund on foot: run
    left/right, grab the <b>Mate</b> bottles on the floor and <b>click to throw them
    at him</b> (aim with the mouse). Your <b>Paper</b> from all levels is your shield."
  rowsCaption: ON THE WAY UP
  rows:
  - icon: {fileID: 21300000, guid: 77cd812f5567e6a4a84bcb03655509e1, type: 3}
    name: Research
    text: Data +1, citation +2, paper +3. Paper = shield in the defense
  - icon: {fileID: 21300000, guid: 101ecb369d6e9bf4395fe512be3677ed, type: 3}
    name: Mate
    text: 'Climb: jetpack boost up. Defense: ammo to throw'
  - icon: {fileID: 21300000, guid: a967ed6cd80c9cc44a13d9e23bfda573, type: 3}
    name: Springs
    text: Paper stacks and organ pipes bounce you extra high
  - icon: {fileID: 21300000, guid: 24d3f1223ad2e6c48b8e6329f4f3bacf, type: 3}
    name: Desk Reject
    text: Library book stacks crumble after one bounce
  - icon: {fileID: 21300000, guid: d70276d2f7abf1342a8ce777d3a01a87, type: 3}
    name: Reviewer 2
    text: Bounce on it from above. A hit costs 6 s and 2 paper
  - icon: {fileID: 21300000, guid: 6fe1fc21d9f9bf54da6d53712179cec8, type: 3}
    name: Coffee cups
    text: 'Fall from above: watch for the ! at the top'
  - icon: {fileID: 21300000, guid: 91d37e370a19ac140bad165c80224226, type: 3}
    name: Imposter syndrome
    text: Makes platforms vanish. Flash it away!
  - icon: {fileID: 21300000, guid: 39d46b1d5e83cc24a88afa6c860a2d72, type: 3}
    name: Prof. Siegmund
    text: Dodge red pens and boxes, hit him with thrown Mate
  keys:
  - key: "\u2190 / \u2192  or  A / D"
    action: Steer (leave one side, come back on the other)
  - key: nothing
    action: 'Jumping is automatic: Johannes bounces on every landing'
  - key: Q
    action: 'Camera flash: stuns drones, banishes shadows, takes photos'
  - key: Mouse click
    action: 'Defense: throw a Mate where the mouse points'
  - key: Ctrl+Shift+R
    action: Restart the level
  gamepadNote: 'Gamepad: stick or d-pad steer, B flash, X throws Mate at the professor'
  font: {fileID: 12800000, guid: 81e9eeb7a44c7f84d9d5f69101f4a00b, type: 3}
