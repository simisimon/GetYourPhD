MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1526086312}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 199f375115502e748a54b5997d9f2add, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GetYourPhD.HowToPlayOverlay
  levelId: L1
  title: 'LEVEL 1: THE MEASUREMENT LAB'
  intro: 'Run and jump through the lab and collect research to fill the <b>Paper</b>
    meter (0-100%). Beat the Benchmark Cluster, then reach the <b>Submit</b> button
    before the deadline (<b>13:59 AOE</b>). When time runs out, the paper is submitted
    automatically. The reviewers always want a rebuttal: head to the <b>Rebuttal
    Room</b> to win it.'
  rowsCaption: COLLECTIBLES
  rows:
  - icon: {fileID: 21300000, guid: 77cd812f5567e6a4a84bcb03655509e1, type: 3}
    name: Data point
    text: +1 paper
  - icon: {fileID: 21300000, guid: b4c3e5d24eea2d84db0a4aa9568a79f2, type: 3}
    name: Feedback
    text: +2 paper
  - icon: {fileID: 21300000, guid: 64b35018f67c3b049a5907e728c40491, type: 3}
    name: Experiment result
    text: +3 paper
  - icon: {fileID: 21300000, guid: 74c540219721906429edf48de9feeefe, type: 3}
    name: Paper draft
    text: +5 paper
  - icon: {fileID: 21300000, guid: 101ecb369d6e9bf4395fe512be3677ed, type: 3}
    name: Mate
    text: 'Drink: 5 s speed boost. Throw: hits distractions, switches, boss'
  - icon: {fileID: 21300000, guid: fd692603197647c42a31858eb201c795, type: 3}
    name: Photo spot
    text: Hidden. Use the camera flash right next to it
  - icon: {fileID: 21300000, guid: b7e8c1cebf529074fb57dc2f62877ad7, type: 3}
    name: Distractions
    text: A hit costs 10 s and 2 paper. Stomp them or throw Mate
  keys:
  - key: "A / D  or  \u2190 / \u2192"
    action: Move
  - key: "Space / W / \u2191"
    action: 'Jump (again in the air: double jump)'
  - key: Left click
    action: Drink Mate (speed boost)
  - key: Right click
    action: Throw Mate
  - key: Q
    action: 'Camera flash: stun, reveal platforms, take photos'
  - key: "E / S / \u2193"
    action: Interact (config switches, doors)
  gamepadNote: 'Gamepad: stick move, A jump, X throw, Y drink, B flash, RB interact'
  font: {fileID: 12800000, guid: 81e9eeb7a44c7f84d9d5f69101f4a00b, type: 3}
