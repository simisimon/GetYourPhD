MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1703906787}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 199f375115502e748a54b5997d9f2add, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GetYourPhD.HowToPlayOverlay
  levelId: L2
  title: 'LEVEL 2: HOME SWEET HOME OFFICE'
  intro: 'No running and jumping this time: the paper is written at home. The <b>Paper</b>
    meter only grows while Johannes <b>stands still at his desk</b>. Meanwhile, life
    happens in the flat: fix problems before they get out of hand. At 100%, press
    E at the desk to <b>submit</b> before <b>13:59 AOE</b>, then head to the <b>Rebuttal
    Room</b> in the yard.'
  rowsCaption: AT HOME
  rows:
  - icon: {fileID: 21300000, guid: 0c3a00680e07875428bdbe3ac57d05c1, type: 3}
    name: Desk
    text: Stand still to type. Every open problem in the flat costs focus
  - icon: {fileID: 21300000, guid: 9fddc41b36902b046ba64b860df3c605, type: 3}
    name: Daughter
    text: 'Crying: hold E at the crib, throw Mate or use the flash'
  - icon: {fileID: 21300000, guid: 4f0a795ad8c68ae43bd3f8c2e4e3913c, type: 3}
    name: Washing machine
    text: 'Flooding: hold E next to it or throw Mate'
  - icon: {fileID: 21300000, guid: 98c5d1f559ba08e408b8ae357861a5a7, type: 3}
    name: Doorbell
    text: 'Parcel: hold E at the front door'
  - icon: {fileID: 21300000, guid: 9feaeedd082f5ff4bb879c0132296f9e, type: 3}
    name: Tool wall
    text: Tools fall on the desk and slow typing. Hold E at the desk
  - icon: {fileID: 21300000, guid: b92988bfcb5c5b64a8967df22d46a1d1, type: 3}
    name: Wife
    text: 'Cooks and jokes. Orders: walk to her and hold E'
  - icon: {fileID: 21300000, guid: 479a43a16c78cd44fa469eec2ca2be83, type: 3}
    name: Fridge
    text: Press E for 2 Mate (then it needs to restock)
  - icon: {fileID: 21300000, guid: 64b35018f67c3b049a5907e728c40491, type: 3}
    name: Idea
    text: 'Pops up somewhere in the flat: +3 paper'
  - icon: {fileID: 0}
    name: Ignored problem
    text: 'Gets out of hand: -8 s and -2 paper, again and again'
  keys:
  - key: "A / D  or  \u2190 / \u2192"
    action: Move
  - key: "Space / W / \u2191"
    action: Jump (through the hall steps to go upstairs)
  - key: Hold E
    action: Fix a problem, hang tools back up, help your wife
  - key: E at the desk
    action: Submit when the paper is at 100%
  - key: Right click
    action: Throw Mate (fixes problems from afar)
  - key: Left click
    action: Drink Mate (run and type faster)
  - key: Q
    action: 'Camera flash: calms the daughter, takes photos'
  gamepadNote: 'Gamepad: stick move, A jump, X throw, Y drink, B flash, RB interact'
  font: {fileID: 12800000, guid: 81e9eeb7a44c7f84d9d5f69101f4a00b, type: 3}
