--- !u!114 &217416437
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 217416435}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 199f375115502e748a54b5997d9f2add, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GetYourPhD.HowToPlayOverlay
  levelId: L3
  title: 'LEVEL 3: THE CAMPER ROAD TRIP'
  intro: 'The defense is far away: drive the <b>camper</b> from <b>Italy</b> over
    the <b>Alps</b> home to the <b>Paulinum in Leipzig</b> before <b>13:59 AOE</b>.
    Watch the <b>fuel</b> and the <b>dents</b>: an empty tank sends you back to the
    last border, and a <b>third crash</b> ends the trip: the paper is <b>submitted
    as is</b>. Gas stations and workshops on the right help, but cost time.'
  rowsCaption: ON THE ROAD
  rows:
  - icon: {fileID: 21300000, guid: ba4d3c7d55d0f984188fcacdb6d8e786, type: 3}
    name: Jerry can
    text: +15 fuel. Speeding burns fuel much faster
  - icon: {fileID: 21300000, guid: 1a8e7bb9d16310e4d998f07d2b8375d3, type: 3}
    name: Gas / Workshop
    text: 'Steer right into it: full tank (-6 s) or repair (-16 s)'
  - icon: {fileID: 21300000, guid: 0551fffe2a436684ab47c10ad31d9f44, type: 3}
    name: Paper, citation
    text: +3 / +1 paper
  - icon: {fileID: 21300000, guid: a455d39445743c04ba8a2ae1f23c795d, type: 3}
    name: Approved stamp
    text: '"Reviewer 2 approved": +6 paper'
  - icon: {fileID: 21300000, guid: 101ecb369d6e9bf4395fe512be3677ed, type: 3}
    name: Mate
    text: Turbo for a few seconds
  - icon: {fileID: 21300000, guid: ca420ccae9703d64a94a312aff6cc621, type: 3}
    name: Reviewer 2
    text: Chases you. Swerve at the last moment or brake
  - icon: {fileID: 21300000, guid: 792f2c353dc206149b08612c5a88e6c9, type: 3}
    name: Desk Reject
    text: 'Pothole: a dent and -4 paper'
  - icon: {fileID: 21300000, guid: 9b98c9dcaef39fa43ac106c20a804268, type: 3}
    name: Postcard
    text: One hidden in every country. Collect them all!
  keys:
  - key: "\u2190 / \u2192  or  A / D"
    action: Change lanes (and turn into gas stations / workshops)
  - key: "\u2191 / W"
    action: Accelerate (the Ducato is slow to speed up)
  - key: "\u2193 / S"
    action: Brake (slow down for tolls, cows and curves)
  - key: nothing
    action: The camper cruises at a comfy 90 km/h
  gamepadNote: 'Gamepad: stick or d-pad steer, A / RT accelerate, X / LT brake'
  font: {fileID: 12800000, guid: 81e9eeb7a44c7f84d9d5f69101f4a00b, type: 3}
